# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# --- Google Sheets (Rota + Team + MessageLog) -------------------------------
# See README.md "Google Sheets setup" for how to create these.
GOOGLE_SPREADSHEET_ID=replace-with-your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-your-service-account@your-project.iam.gserviceaccount.com
# The service account's private key, PEM format, with real newlines replaced
# by literal "\n" so it fits on one line. Keep the surrounding quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-key\n-----END PRIVATE KEY-----\n"
# NOTE: the spreadsheet must be shared with this service account as an
# EDITOR (not Viewer) -- the app creates/appends to a "MessageLog" worksheet
# for its reminder history. It only ever reads Rota and Team, never writes
# to them.

# --- Twilio (SMS) ------------------------------------------------------------
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACreplace_with_your_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
# Your Twilio SMS-capable sender number, E.164 format.
TWILIO_SMS_FROM_NUMBER=+10000000000

# Your own number, to receive the Sunday admin notification and the
# dashboard's standalone "Send a test SMS" control. Same UK formats as the
# Team sheet are accepted (07..., 7..., 44..., +44...).
ADMIN_PHONE_NUMBER=07000000000

# --- Reminder processor endpoint --------------------------------------------
# Shared secret required (as `Authorization: Bearer <value>`) to call
# GET/POST /api/reminders/run. Vercel Cron sends this automatically once
# CRON_SECRET is set as a project environment variable. Generate one with:
#   openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string
